# 构建上下文只需要应用代码、锁文件和容器脚本。
.git/
.github/
.gitignore
.dockerignore

# 密钥和本机配置不会进入镜像。
.env
.env.*
.secrets/

# 本地环境、缓存、日志和验收输出。
.venv/
.cache/
.logs/
.models/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
verification/
__pycache__/
*.pyc

# 运行时不需要，用于减小 API 镜像体积。
# 注意不要忽略 app/prompts/*.md，提示词随应用代码进入镜像。
tests/
docs/
skills/
interfaces/
data/
config/
ocr/
README.md
AGENTS.md
CLAUDE.md

.agents/
.codex/
.vscode/
.DS_Store
