            "items": {
              "type": "string",
              "maxLength": 300,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 8,
            "title": "Pending Items",
            "description": "仅输入明确的待办或进行中事项；空值及未记录合格率不产生待办，无则[]。"
          },
          "issues": {
            "items": {
              "type": "string",
              "maxLength": 300,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 8,
            "title": "Issues",
            "description": "输入原表明确的不合格结论、问题、风险或矛盾，必须保留；例如结论为宽度不合格则列出宽度不合格；未填合格率不属于质量问题，无则[]。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "date",
          "summary",
          "completed_items",
          "pending_items",
          "issues"
        ],
