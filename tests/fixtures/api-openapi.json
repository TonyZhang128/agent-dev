  "components": {
    "schemas": {
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "History",
            "description": "当前用户当前会话的完整历史，首轮为[]"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "history",
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "minLength": 1,
            "title": "Reply"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reply",
          "model"
        ],
        "title": "ChatResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntentRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "History",
            "description": "当前用户当前会话的完整历史，首轮为[]"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "description": "待识别的页面导航或一般交流内容"
          },
          "intents": {
            "items": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "array",
            "maxItems": 0,
            "title": "Intents",
            "description": "仅为兼容保留，必须省略或为[]；不支持自定义分类，始终使用固定五类意图"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "history",
          "text"
        ],
        "title": "IntentRequest"
      },
      "IntentResult": {
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "work_list",
              "supervision_log",
              "image_library",
              "business_management",
              "chat",
              "unknown"
            ],
            "title": "Intent"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason"
          },
          "needs_clarification": {
            "type": "boolean",
            "title": "Needs Clarification"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "intent",
          "confidence",
          "reason",
          "needs_clarification"
        ],
        "title": "IntentResult"
      },
      "JsonValue": {},
      "LogSummary": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Date",
            "description": "原样摘录输入date、日志日期或检测日期；检测日期优先于计划日期。例如检测日期2024年10月26日则输出2024年10月26日；只有计划日期时为null。"
          },
          "summary": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Summary",
            "description": "可纳入当日日志的客观中文段落，保留施工标段、部位、指标、全部原始实测值及单位；禁止换算，例如弯沉0.1、0.2、0.3（单位0.01mm）必须保持这三个数值；不推断合格结论。"
          },
          "completed_items": {
            "items": {
              "type": "string",
              "maxLength": 300,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 8,
            "title": "Completed Items",
            "description": "仅输入明确写出已完成的事项；只有表格、测量数据或检测日期时必须为[]，不能添加完成检测或完成记录填写。"
          },
          "pending_items": {
            "items": {
              "type": "string",
              "maxLength": 300,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 8,
            "title": "Pending Items",
            "description": "仅输入明确的待办或进行中事项；空值及未记录合格率不产生待办，无则[]。"
          },
          "issues": {
            "items": {
              "type": "string",
              "maxLength": 300,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 8,
            "title": "Issues",
            "description": "输入原表明确的不合格结论、问题、风险或矛盾，必须保留；例如结论为宽度不合格则列出宽度不合格；未填合格率不属于质量问题，无则[]。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "date",
          "summary",
          "completed_items",
          "pending_items",
          "issues"
        ],
        "title": "LogSummary"
      },
      "LogSummaryRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              }
            ],
            "title": "Content",
            "description": "工程表单 OCR 识别对象，内部字段和层级可变化；兼容通用日志文字或对象。非空，按 json.dumps(ensure_ascii=False) 序列化后最多4000字符；顶层不接受数组。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "content"
        ],
        "title": "LogSummaryRequest",
        "description": "可变结构的工程表单 OCR JSON 或兼容文字，序列化后最多 4000 字符。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "DraftReq": {
        "properties": {
          "prefix": {
            "type": "string",
            "minLength": 1,
            "title": "Prefix"
          },
          "drawings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Drawings"
          },
          "basis": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Basis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prefix",
          "drawings"
        ],
        "title": "DraftReq"
      },
      "FillReq": {
        "properties": {
          "form": {
            "type": "string",
            "minLength": 1,
            "title": "Form"
          },
          "cfg": {
            "additionalProperties": true,
            "type": "object",
            "title": "Cfg"
          },
          "values": {
            "additionalProperties": true,
            "type": "object",
            "title": "Values"
          },
          "out": {
            "type": "string",
            "title": "Out",
            "default": ""
          },
          "rects": {
            "additionalProperties": true,
            "type": "object",
            "title": "Rects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "form",
          "cfg",
          "values"
        ],
        "title": "FillReq"
      },
      "JianbiaoReq": {
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "title": "Path"
          },
          "form": {
            "type": "string",
            "minLength": 1,
            "title": "Form"
          },
          "cfg": {
            "additionalProperties": true,
            "type": "object",
            "title": "Cfg"
          },
          "bound": {
            "additionalProperties": true,
            "type": "object",
            "title": "Bound"
          },
          "out": {
            "type": "string",
            "title": "Out",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "form",
          "cfg"
        ],
        "title": "JianbiaoReq"
      },
      "RecognizeReq": {
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "title": "Path"
          },
          "form": {
            "type": "string",
            "title": "Form",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path"
        ],
        "title": "RecognizeReq"
      }
    }
  }
}
