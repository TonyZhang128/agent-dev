  "components": {
    "schemas": {
      "ArchiveIntentResult": {
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "unknown"
            ],
            "title": "Intent"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "reason": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Reason"
          },
          "needs_clarification": {
            "type": "boolean",
            "title": "Needs Clarification"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "intent",
          "confidence",
          "reason",
          "needs_clarification"
        ],
        "title": "ArchiveIntentResult",
        "description": "文件归档系统的意图识别结果；当前无聊天分流，理由始终简短。"
      },
      "BusinessIntentOption": {
        "properties": {
          "page": {
            "type": "string",
            "enum": [
              "supervision_diary",
              "work_list",
              "image_library",
              "recognition_platform",
              "business_management",
              "workbench"
            ],
            "title": "Page"
          },
          "action": {
            "type": "string",
            "enum": [
              "fill_supervision_log",
              "fill_monthly_report",
              "assign_monthly_report",
              "view_supervision_log",
              "fill_inspection_record",
              "fill_standby_record",
              "fill_environmental_log",
              "fill_safety_log",
              "approve_log",
              "view_work_tasks",
              "create_work_task",
              "add_form",
              "delete_supervision_form",
              "view_approval_workflow",
              "view_image_library",
              "delete_image",
              "create_album",
              "delete_album",
              "navigate_to_recognition",
              "recognize_photo",
              "add_personnel_configuration",
              "delete_project_member",
              "view_wbs",
              "add_subproject",
              "add_child_subproject",
              "delete_subproject",
              "delete_child_subproject",
              "assign_wbs_personnel",
              "navigate_to_work",
              "view_today_tasks",
              "view_pending_approvals"
            ],
            "title": "Action"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "page",
          "action",
          "name"
        ],
        "title": "BusinessIntentOption",
        "description": "澄清时可选的合法二级功能。"
      },
      "BusinessIntentRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "History",
            "description": "当前用户当前会话的完整历史，首轮为[]；可省略"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "current_page": {
            "type": "string",
            "enum": [
              "supervision_diary",
              "work_list",
              "image_library",
              "recognition_platform",
              "business_management",
              "workbench"
            ],
            "title": "Current Page",
            "description": "调用方当前实际页面编码"
          },
          "last_navigation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BusinessNavigationContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending_clarification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingClarification"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "调用方幂等标识；本服务不持久化，仅供调用方关联"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "message",
          "current_page"
        ],
        "title": "BusinessIntentRequest",
        "description": "无状态业务意图请求；会话上下文由调用方传入。"
      },
      "BusinessIntentResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "clarify",
              "chat",
              "unknown"
            ],
            "title": "Status"
          },
          "page": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "supervision_diary",
                  "work_list",
                  "image_library",
                  "recognition_platform",
                  "business_management",
                  "workbench"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fill_supervision_log",
                  "fill_monthly_report",
                  "assign_monthly_report",
                  "view_supervision_log",
                  "fill_inspection_record",
                  "fill_standby_record",
                  "fill_environmental_log",
                  "fill_safety_log",
                  "approve_log",
                  "view_work_tasks",
                  "create_work_task",
                  "add_form",
                  "delete_supervision_form",
                  "view_approval_workflow",
                  "view_image_library",
                  "delete_image",
                  "create_album",
                  "delete_album",
                  "navigate_to_recognition",
                  "recognize_photo",
                  "add_personnel_configuration",
                  "delete_project_member",
                  "view_wbs",
                  "add_subproject",
                  "add_child_subproject",
                  "delete_subproject",
                  "delete_child_subproject",
                  "assign_wbs_personnel",
                  "navigate_to_work",
                  "view_today_tasks",
                  "view_pending_approvals"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "options": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/BusinessIntentOption"
                },
                "type": "array",
                "maxItems": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Options"
          },
          "catalog_version": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Catalog Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "page",
          "action",
          "confidence",
          "message",
          "options",
          "catalog_version"
        ],
        "title": "BusinessIntentResult",
        "description": "业务意图识别响应；status 区分跳转、澄清、聊天和未知。"
      },
      "BusinessNavigationContext": {
        "properties": {
          "page": {
            "type": "string",
            "enum": [
              "supervision_diary",
              "work_list",
              "image_library",
              "recognition_platform",
              "business_management",
              "workbench"
            ],
            "title": "Page"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fill_supervision_log",
                  "fill_monthly_report",
                  "assign_monthly_report",
                  "view_supervision_log",
                  "fill_inspection_record",
                  "fill_standby_record",
                  "fill_environmental_log",
                  "fill_safety_log",
                  "approve_log",
                  "view_work_tasks",
                  "create_work_task",
                  "add_form",
                  "delete_supervision_form",
                  "view_approval_workflow",
                  "view_image_library",
                  "delete_image",
                  "create_album",
                  "delete_album",
                  "navigate_to_recognition",
                  "recognize_photo",
                  "add_personnel_configuration",
                  "delete_project_member",
                  "view_wbs",
                  "add_subproject",
                  "add_child_subproject",
                  "delete_subproject",
                  "delete_child_subproject",
                  "assign_wbs_personnel",
                  "navigate_to_work",
                  "view_today_tasks",
                  "view_pending_approvals"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "page"
        ],
        "title": "BusinessNavigationContext",
        "description": "调用方最近一次返回过的导航目标；只作为纠错上下文。"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "History",
            "description": "当前用户当前会话的完整历史，首轮为[]"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "history",
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "minLength": 1,
            "title": "Reply"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reply",
          "model"
        ],
        "title": "ChatResponse"
      },
      "DailyLogsReq": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "PROJECTS_ROOT 数据池内的监理日志照片路径",
            "default": ""
          },
          "img": {
            "type": "string",
            "title": "Img",
            "description": "base64 编码的图片数据；path 与 img 至少提供一个",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DailyLogsReq"
      },
      "DraftReq": {
        "properties": {
          "prefix": {
            "type": "string",
            "minLength": 1,
            "title": "Prefix"
          },
          "drawings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Drawings",
            "description": "PROJECTS_ROOT 数据池内的 PDF 路径或目录列表"
          },
          "imgs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Imgs",
            "description": "base64 编码的 PDF 数据列表；drawings 与 imgs 至少提供一个"
          },
          "basis": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
