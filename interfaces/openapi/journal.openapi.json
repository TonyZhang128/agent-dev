  "components": {
    "schemas": {
      "JournalReq": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "PROJECTS_ROOT 数据池内的监理日志照片路径",
            "default": ""
          },
          "img": {
            "type": "string",
            "title": "Img",
            "description": "base64 编码的图片数据；path 与 img 至少提供一个",
            "default": ""
          },
          "taskId": {
            "type": "string",
            "maxLength": 128,
            "title": "TaskId",
            "description": "业务任务 ID，仅原样回显到 processed.taskId；不传则为 null",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "JournalReq",
        "description": "新版监理日志识别请求；与旧接口字段一致，实现链独立。"
      },
      "JournalResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "const": 200
          },
          "message": {
            "type": "string",
            "const": "success"
          },
          "data": {
            "$ref": "#/components/schemas/JournalResponseData"
          }
        }
      },
      "JournalImageInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "width",
          "height",
          "coordinateSpace"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "coordinateSpace": {
            "type": "string",
            "const": "exif_corrected_original"
          }
        }
