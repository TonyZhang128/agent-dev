{
  "openapi": "3.1.0",
  "info": {
    "title": "监理日记三入口正式子契约",
    "version": "2.0.0",
    "x-contract-status": "confirmed",
    "description": "2026-11-12 用户批准两阶段串联方案及完整业务输出。recognize 图片识别结果 data 可直接传给 process；journal 内部顺序执行相同两阶段。"
  },
  "paths": {
    "/ocr/journal": {
      "post": {
        "tags": [
          "ocr"
        ],
        "summary": "识别并处理监理日记",
        "description": "组合入口：内部顺序执行与 recognize 相同的图片识别阶段，再执行与 process 相同的业务生成阶段；一次 OCR，不通过 HTTP 调用自身。返回与 process 相同的最终业务格式。识别失败停止，不继续生成。",
        "operationId": "journal_recognize_ocr_journal_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalReq"
              },
              "example": {
                "path": "projects/监理日志照片.jpg",
                "taskId": "123456789012345678"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "规定的完整业务日记；其他栏目与工作原文保留，Agent 生成施工和巡视/旁站子项。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalResponse"
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": {
                    "jsonData": {
                      "common": {
                        "projectName": "成乐高速公路扩容建设",
                        "documentNo": "20261108301720230410S210-1",
                        "supervisionOrg": "成乐高速公路扩容建设项目JL7总监办",
                        "recorderName": null,
                        "recorderPosition": "专业监理工程师",
                        "weather": "晴",
                        "logDate": "2026-11-01",
                        "reviewerName": null
                      },
                      "fields": {
                        "mainWork": {
                          "content": "",
                          "construction": "路基第8层土方填筑碾压。",
                          "patrol": {
                            "inspectionScope": "对XX交安施工区域相关部位进行巡视。现场施工工艺符合批准的施工组织设计/专项施工方案，主要机械设备运行正常，特种作业人员持证上岗；测量放样、技术交底落实；未见违规违章作业。",
                            "mainConstruction": "对XX交安施工区域进行巡视。当日施工内容为……（如：XX标线波形板施工、XX标线施工、XX材料进场等），投入作业人员X人、主要设备X台，工序衔接有序。",
                            "qualitySafetyEnvironment": "示例（交安专业）：巡查标志基础混凝土浇筑及标志牌立柱垂直度；检查波形梁护栏立柱间距、埋深及线形（抽查X处，线形顺畅、顺接平顺）；抽查标线放样及热熔涂料干膜厚度（1.8~2.2mm）；隔离栅基础及轮廓标、防眩板安装。安全：占道施工交通组织与警示标志；环保：施工废料回收。",
                            "problemsAndActions": "发现……问题X项（如：立柱竖直度、立柱间距等），已现场口头通知整改X项，必要时下发《监理通知单》（编号XXX），明确整改要求与期限，跟踪闭环。"
                          },
                          "witness": {
                            "supervisionProject": "XX桩号基层、底基层试验段",
                            "constructionProcess": "当日施工内容为……（如：XX桥3#墩柱模板安装、XX钢筋绑扎），投入作业人员X人、主要设备X台，工序衔接有序。",
                            "supervisionWork": "1、现场特种作业人员、证件情况，现场安全措施。2、现场具体施工工序是否满足规范要求。3、现场见证取样情况，如砼试件、塌落度等。",
                            "mainDataRecords": "指标检查情况，实测值、设计值，是否满足现场要求。（如孔径、孔深、首盘砼方量、松铺厚度、摊铺厚度、温度、碾压遍数、横纵断面高程尺寸等）",
                            "problemsAndResults": "发现……问题X项，已现场口头通知整改X项，必要时通知专业监理下发《监理通知单》（编号XXX），明确整改要求与期限，跟踪闭环。"
                          }
                        },
                        "issues": "挡土墙墙背回填局部压实不足，已完成补压。",
                        "nextDayPlan": "继续旁站路基第9层填筑。"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "请求校验失败，或输入与上下文超过预算。校验失败时 detail 为错误数组；输入超限时为字符串。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestError"
                }
              }
            }
          },
          "400": {
            "description": "路径越界、文件不存在/不是文件、图片无法解码、未检测到通过模板结构核验的监理日志表格，或文档处理失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "502": {
            "description": "工作内容生成失败：模型不可用、超时、有效文本超过 4000 字符或生成结果未通过结构/关键数据校验；沿用既有 detail 错误包装和固定文案。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "503": {
            "description": "OCR 模型不可用。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          }
        },
        "x-contract-status": "confirmed",
        "x-contract-source": "用户于 2026-11-12 明确批准两阶段串联、完整业务输出、JournalAgent 命名及删除关键词/规则路径。",
        "x-side-effects": "只读取数据池照片，不写 PDF/Excel。",
        "x-idempotency": "识别结果可能因模型和照片变化而不同；只读调用可重试。"
      }
    },
    "/ocr/journal/recognize": {
      "post": {
        "tags": [
          "ocr"
        ],
        "summary": "仅识别监理日记",
        "description": "仅执行表格定位、整页一次 OCR 和栏目提取，不执行工作内容拆分或调用语言模型。返回全部原始文字框及拆分前栏目文本；坐标统一为 EXIF 校正后、缩小前的图片像素坐标。",
        "operationId": "journal_recognize_only_ocr_journal_recognize_post",
        "x-contract-status": "confirmed",
        "x-contract-source": "用户于 2026-11-12 明确批准三入口方案；interfaces/drafts/journal-capabilities.md；interfaces/openapi/journal.openapi.json",
        "x-side-effects": "不写文件、不持久化会话。",
        "x-idempotency": "只读，可重试。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalReq"
              },
              "example": {
                "path": "projects/监理日志照片.jpg",
                "taskId": "example"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalRecognitionResponse"
                }
              }
            }
          },
          "400": {
            "description": "路径、图片或表格定位失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "请求校验失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestError"
                }
              }
            }
          },
          "503": {
            "description": "OCR 模型或资源不可用。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          }
        }
      }
    },
