# macOS development defaults. Linux template: scripts/prod/api.env.example
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.5:9b-q4_K_M
# Ollama ignores this placeholder. Set a real server key for vLLM if required.
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
# Both current Ollama and vLLM support reasoning_effort=none for Qwen.
LLM_REASONING_EFFORT=none
AGENT_RECURSION_LIMIT=8
# Traces are disabled by default; enabling also needs LangSmith process credentials.
LANGSMITH_TRACING=false
