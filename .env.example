# macOS 开发默认值。Linux 模板见 scripts/prod/api.env.example。
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.5:9b-q4_K_M
# Ollama 会忽略该占位值；使用需要鉴权的 vLLM 等服务时填写真实 key。
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
# 与实际服务的上下文容量一致；历史裁剪使用保守的字节估算。
LLM_CONTEXT_TOKENS=8192
LLM_CONTEXT_MARGIN_TOKENS=256
CONVERSATION_MAX_INPUT_CHARACTERS=1000000
# 当前 Ollama 和 vLLM 都支持 Qwen 的 reasoning_effort=none。
LLM_REASONING_EFFORT=none
# 可选云端回退：本地 Ollama/vLLM 的模型调用失败时改调该 OpenAI 兼容服务。
# 仅 ENABLED=true 且 API_KEY 非空时启用；关闭开关可保留密钥。DeepSeek 不支持 strict json_schema，
# 应用会在回退时降级为 JSON 模式，并继续用 Pydantic 校验结构化结果。
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_MODEL=deepseek-flash
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_TIMEOUT_SECONDS=60
# DeepSeek 用 reasoning_effort=none 关闭思考；不支持的服务可留空。
LLM_FALLBACK_REASONING_EFFORT=none
AGENT_RECURSION_LIMIT=8
# 监理日记生成：模型总预算（含并发排队和回退），超时返回受控 502。
JOURNAL_TIMEOUT_SECONDS=30
# 监理日记生成并发上限；OCR 本身仍按应用串行加锁。
JOURNAL_CONCURRENCY=1
# 追踪默认关闭；启用时还需要在进程环境中提供 LangSmith 凭据。
LANGSMITH_TRACING=false

# OCR 路径以仓库根目录解析；与 Java 服务共用同一数据池。
TEMPLATES_ROOT=data/ocr/templates
ADMIN_ROOT=data/ocr/admin
ASSET_ROOT=data/ocr/assets
PROJECTS_ROOT=data/ocr/projects
# OCR 模型缓存（PP-OCRv6 Medium / PP-OCRv5 Server cls）；目录必须可写。
# 可用 `uv run --locked python -m scripts.models.download_ocr_models` 预置。
OCR_MODEL_ROOT=.cache/models/ocr
# OCR 推理设备：cpu（默认，适合无 NVIDIA GPU 的开发/Mac 环境）或 cuda（需 CUDA 12 + cuDNN 9，
# 并通过 --extra ocr-gpu 安装 onnxruntime-gpu；该 extra 与 ocr-cpu 互斥）。cuda 不可用时接口返回 503。
# 两种模式共用同一套 ONNX 模型，仅切换 onnxruntime 执行设备。
OCR_DEVICE=cpu
# 仅 cuda 模式使用：Windows 免安装方案是把 NVIDIA redist 包解压到
# OCR_CUDA_ROOT（Git 已忽略），详见 docs/ocr.md「推理设备」。
OCR_CUDA_ROOT=.cache/cuda
