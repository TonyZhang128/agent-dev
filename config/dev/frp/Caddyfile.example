# 由 /etc/caddy/Caddyfile 导入；兼容服务器上的 Caddy 2.6.4。
# 公网 API 访问不需要账号、密码或 API key。
https://107.182.190.191:8443 {
    tls /etc/caddy/highway-frp/server.crt /etc/caddy/highway-frp/server.key

    reverse_proxy 127.0.0.1:18000 {
        transport http {
            response_header_timeout 210s
        }
    }
}
