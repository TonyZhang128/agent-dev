# Linux API configuration. setup.sh copies this only when the root .env is absent.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=highway-agent
# Replace with the same secret as VLLM_API_KEY in the independent model service.
LLM_API_KEY=CHANGE_ME
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
# Match the model service's actual max context; history is trimmed by complete turns.
LLM_CONTEXT_TOKENS=8192
LLM_CONTEXT_MARGIN_TOKENS=256
CONVERSATION_MAX_INPUT_CHARACTERS=1000000
# Disable thinking in the model service's chat template; leave this empty if unsupported.
LLM_REASONING_EFFORT=
AGENT_RECURSION_LIMIT=8
LANGSMITH_TRACING=false

# Mount the same templates/assets/project pool as the Java service.
TEMPLATES_ROOT=data/ocr/templates
ADMIN_ROOT=data/ocr/admin
ASSET_ROOT=data/ocr/assets
PROJECTS_ROOT=data/ocr/projects
# OCR model cache for PP-OCRv6 Medium / PP-OCRv5 Server cls; must be writable.
OCR_MODEL_ROOT=data/ocr/models
