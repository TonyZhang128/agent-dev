# Linux API configuration. setup.sh copies this only when the root .env is absent.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=qwen-business
# Replace with the same secret as VLLM_API_KEY in the independent model service.
LLM_API_KEY=CHANGE_ME
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
# Disable thinking in the model service's chat template; leave this empty if unsupported.
LLM_REASONING_EFFORT=
AGENT_RECURSION_LIMIT=8
LANGSMITH_TRACING=false
