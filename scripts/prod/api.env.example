# Linux API 配置。仅当根目录 .env 不存在时由 setup.sh 复制。
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=highway-agent
# 替换为与独立模型服务中 VLLM_API_KEY 相同的密钥。
LLM_API_KEY=CHANGE_ME
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
# 与模型服务实际的最大上下文一致；历史按完整回合裁剪。
LLM_CONTEXT_TOKENS=8192
LLM_CONTEXT_MARGIN_TOKENS=256
CONVERSATION_MAX_INPUT_CHARACTERS=1000000
# 关闭模型服务 chat template 中的思考模式；不支持时留空。
LLM_REASONING_EFFORT=
# 可选云端回退：本地 vLLM 调用失败时启用；key 为空即关闭。
LLM_FALLBACK_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_MODEL=deepseek-flash
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_TIMEOUT_SECONDS=60
LLM_FALLBACK_REASONING_EFFORT=none
AGENT_RECURSION_LIMIT=8
LANGSMITH_TRACING=false

# 挂载与 Java 服务相同的模板/资料/项目数据池。
TEMPLATES_ROOT=data/ocr/templates
ADMIN_ROOT=data/ocr/admin
ASSET_ROOT=data/ocr/assets
PROJECTS_ROOT=data/ocr/projects
# PP-OCRv6 Medium / PP-OCRv5 Server cls 的 OCR 模型缓存；目录必须可写。
OCR_MODEL_ROOT=data/ocr/models
