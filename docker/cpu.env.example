# 复制为 docker/cpu.env 并 chmod 600；保留已有配置，不提交真实密钥。
APP_VERSION=0.1.0
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8309

# 必填：供应商提供的 OpenAI 兼容端点、模型 ID 和实际密钥。
# 以下为占位值；部署前全部替换。模型须支持 strict JSON Schema 结构化输出。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=CHANGE_ME
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
LLM_CONTEXT_TOKENS=8192
LLM_CONTEXT_MARGIN_TOKENS=256
CONVERSATION_MAX_INPUT_CHARACTERS=1000000
# 留空省略该参数，避免向不支持的供应商发送 reasoning_effort。
LLM_REASONING_EFFORT=
AGENT_RECURSION_LIMIT=8
JOURNAL_TIMEOUT_SECONDS=30
JOURNAL_CONCURRENCY=1
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# 留空使用命名卷；可指定 UID 10001 可写的宿主机绝对路径。
OCR_MODEL_DIR=
