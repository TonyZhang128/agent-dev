# 生产 compose 变量模板：复制为 docker/prod.env（chmod 600）后修改。
# 不要提交真实密钥；.dockerignore 显式排除 docker/prod.env。

# ---- 镜像 ----
APP_VERSION=0.1.0
# Qwen3.5 GGUF(Q4_K_M) 必须使用带 GGUF 加载能力的镜像，例如：
#   VLLM_BASE_IMAGE=ghcr.io/efschu/shvllm-qwen35-gguf:cu129
# 使用官方 BF16/反量化权重时改回：
#   VLLM_BASE_IMAGE=vllm/vllm-openai:v0.32.0
VLLM_BASE_IMAGE=ghcr.io/efschu/shvllm-qwen35-gguf:cu129

# ---- 模型权重（宿主机预置，只读挂载）----
# 宿主机目录必须已存在，且至少包含 .gguf；GGUF 还需原始 config.json 与 tokenizer 文件。
# 可用 uv run --locked python -m scripts.models.download_qwen35_gguf 生成该目录。
VLLM_MODEL_DIR=/srv/models/qwen3.5-9b-q4_k_m
# 容器内路径必须指向 .gguf 文件：vLLM 按文件识别 GGUF，再从同目录读 config.json/tokenizer；
# 指向目录会被当成普通 HF 模型并加载失败。
VLLM_MODEL_PATH=/models/Qwen3.5-9B-Q4_K_M.gguf
# 必须与 API 的 LLM_MODEL 一致，同时是 OpenAI 兼容接口的 model 字段。
VLLM_SERVED_MODEL_NAME=highway-agent
VLLM_PORT=8001
VLLM_GPU_COUNT=1
# RTX 5090 Laptop 与 OCR 共享 GPU 的初始预算；不是显存隔离或性能保证。
# 以 nvidia-smi 实际显存和双服务并发验收为准，必要时进一步降低。
VLLM_GPU_MEMORY_UTILIZATION=0.75
# 与业务 LLM_CONTEXT_TOKENS 保持一致；按显存与并发调整。
VLLM_MAX_MODEL_LEN=8192
# 首次加载可能超过 10 分钟，按模型体积调整。
VLLM_START_PERIOD=15m
VLLM_LOGGING_LEVEL=INFO
# 本地权重保持 1（离线）；使用 Hugging Face 模型 ID 时改为 0。
HF_HUB_OFFLINE=1

# ---- 鉴权（必填）----
# 同时作为 vLLM 服务端密钥与业务 API 的 LLM_API_KEY；不要写入仓库。
VLLM_API_KEY=CHANGE_ME

# ---- 业务 API ----
# 默认只绑定回环；对外暴露由反向代理负责 TLS 与访问控制。
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8309
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
LLM_CONTEXT_TOKENS=8192
LLM_CONTEXT_MARGIN_TOKENS=256
CONVERSATION_MAX_INPUT_CHARACTERS=1000000
AGENT_RECURSION_LIMIT=8
MAIN_WORK_SPLIT_TIMEOUT_SECONDS=30
MAIN_WORK_SPLIT_CONCURRENCY=1
# 留空；思考模式由 vLLM 的 --default-chat-template-kwargs 关闭。
LLM_REASONING_EFFORT=
# 可选云端回退：本地 vLLM 调用失败时改调 OpenAI 兼容服务；仅 ENABLED=true 且 API_KEY 非空时启用。
# 回退请求会离开本机，涉及业务输入，需按部署合规要求决定是否启用。
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_MODEL=deepseek-flash
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_TIMEOUT_SECONDS=60
LLM_FALLBACK_REASONING_EFFORT=none
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# ---- OCR 数据池（宿主机绝对路径，必须已存在）----
# OCR 推理设备：默认 cuda；镜像包含 CUDA 12.9.1 + cuDNN 9。
# 排查时可设 cpu；整个 Compose 的 vLLM 服务仍要求 NVIDIA GPU。
OCR_DEVICE=cuda
# 分配给业务 API 容器的 GPU 数量；与 vLLM 共享同一块 GPU 时保持 1，
# 并调低 VLLM_GPU_MEMORY_UTILIZATION 给 OCR 留出显存。
OCR_GPU_COUNT=1
OCR_TEMPLATES_DIR=/srv/highway-agent/data/ocr/templates
OCR_ADMIN_DIR=/srv/highway-agent/data/ocr/admin
OCR_ASSETS_DIR=/srv/highway-agent/data/ocr/assets
OCR_PROJECTS_DIR=/srv/highway-agent/data/ocr/projects
# RapidOCR ONNX 模型目录，只读挂载到容器；需先用下载脚本预置：
#   uv run --locked python -m scripts.models.download_ocr_models --root /srv/models/ocr
OCR_MODEL_DIR=/srv/models/ocr
